# 포트 설정
PORT=80

# 대한민국 법제처 국가법령정보 공동활용 Open API (open.law.go.kr) 인증값(OC)
# 미설정 시 로컬 오프라인 데모 모드로 동작합니다.
LAW_OC=

# Google Gemini API Key (aistudio.google.com)
# 미설정 시 규칙 기반 폴백 분석 엔진이 동작합니다.
GEMINI_API_KEY=

# Gemini 모델명 (기본값: gemini-2.5-flash, 장애 시 gemini-flash-latest 자동 폴백)
GEMINI_MODEL=gemini-2.5-flash

# GitHub 토큰 (비공개 레포지토리 배포 시에만 필요)
GITHUB_TOKEN=
